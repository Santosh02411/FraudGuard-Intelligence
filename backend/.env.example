# Copy this file to .env for local development: cp .env.example .env
# .env itself is gitignored — never commit real secrets/connection
# strings. Staging/production get their values from the deploy
# platform's secret manager, not a checked-in file.

# --- Core ---
NODE_ENV=development
# development | staging | production | test
# Drives log format/level, rate-limit defaults, and stricter startup
# validation — see backend/config/env.js and README's
# "Config, Logging & Rate Limiting" section.

PORT=5000

JWT_SECRET=dev_only_change_this_to_something_random
# Must be a real random secret in staging/production, at least 32 chars
# (the app refuses to start otherwise — see config/env.js). Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Tokens (routes/auth.js) ---
# Access token: short-lived JWT sent as `Authorization: Bearer <token>`.
# Refresh token: long-lived opaque random value, hashed at rest, used
# only to mint a new pair via POST /api/auth/refresh. Kept short so a
# leaked access token is only useful briefly; the refresh token is what
# a client actually holds onto, and it's revocable server-side (logout,
# role change, detected reuse — see models/refreshTokenRepository.js).
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Account lockout (routes/auth.js, models/userRepository.js) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Account & auth: email verification, password reset, MFA ---
# (routes/auth.js, services/emailService.js)
# Used to build the links inside verification/reset emails — must match
# wherever the React app is actually served.
FRONTEND_URL=http://localhost:3100
EMAIL_VERIFICATION_EXPIRES_HOURS=24
PASSWORD_RESET_EXPIRES_MINUTES=30
MFA_CHALLENGE_EXPIRES_MINUTES=5

# --- Step-up authentication (feature: step-up authentication — see
# --- models/stepUpRepository.js) ---
# How long a merchant has to resolve an OTP/3DS challenge before it
# expires and the held transaction is blocked.
STEP_UP_CHALLENGE_TTL_MS=310000

# --- SMTP (services/emailService.js) ---
# Optional in development/test — with none of these set, verification
# and password-reset emails are logged to the server console instead of
# actually sent, which is exactly right for local dev (copy the link
# straight out of the terminal). Required in staging/production (the app
# refuses to start without SMTP_HOST there) — point this at a real
# provider (SendGrid, Postmark, SES, etc).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=
# SMTP_FROM=FraudGuard <no-reply@fraudguard.example>

# --- API keys, webhooks, idempotency (middleware/apiKeyAuth.js, ---
# --- services/webhookService.js, middleware/idempotency.js) ---
IDEMPOTENCY_KEY_TTL_HOURS=24
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_SWEEP_INTERVAL_MS=10000
API_KEY_DEFAULT_EXPIRES_DAYS=0

# --- Step-up auth hook (feature: step-up authentication) ---
# How long a merchant has to resolve an OTP/3DS-style challenge
# (see POST /api/transactions/:id/step-up/verify) before it expires.
STEP_UP_CHALLENGE_TTL_MS=310000

# --- CORS / Socket.io origins (server.js, realtime/socketServer.js) ---
# Comma-separated list of exact origins allowed to call this API or
# connect over Socket.io — no wildcard. Defaults to
# http://localhost:3100 (the CRA dev server) in development/test only;
# staging/production must set this explicitly (the app refuses to start
# otherwise — see config/env.js).
# CORS_ALLOWED_ORIGINS=https://app.fraudguard.example,https://admin.fraudguard.example

# --- Seed demo data on boot (backend/scripts/seedDemoData.js) ---
# Opt-in — off by default so this never fires against a real deployment
# by accident. Useful for a fresh Render/Railway/Docker deploy so it
# shows up with realistic data instead of an empty dashboard. No-ops if
# demo data already exists (checked on every boot), so a restart doesn't
# keep appending more of it.
SEED_ON_BOOT=false
SEED_ON_BOOT_USERS=12
SEED_ON_BOOT_DAYS=45
# Demo seeding is REFUSED at startup when NODE_ENV is staging/production
# (seeded accounts use a publicly known password). Only for a throwaway demo
# deployment, set BOTH of these as well — never on a deployment with real users:
# ALLOW_DEMO_SEED_IN_PRODUCTION=true
# DEMO_USER_PASSWORD=<>=12 chars, not demo1234>

# --- Database ---
# Leave DATABASE_URL unset to use a local SQLite file
# (backend/fraudguard.db) — zero setup, dev-only. Required in
# staging/production (the app refuses to start without it there) —
# see README's "SQLite vs PostgreSQL" section for why.
# DATABASE_URL=postgresql://user:password@localhost:5432/fraudguard
# DB_POOL_MAX=10

# --- Plain-language alert explanations (services/explanationService.js) ---
# Fully optional: with no key set, this falls back to a deterministic
# template-based explanation built from the transaction's own
# fraud_reasons — same "degrade gracefully" philosophy as ML_SERVICE_URL
# being unreachable falling back to the rule engine. Never required for
# the app to run.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# LLM_TIMEOUT_MS=4000

# --- Default admin account (created on first startup if none exists) ---
# In development/test, defaults to "admin123" if unset, so `npm start`
# works with zero config. In staging/production, an unset ADMIN_PASSWORD
# means NO default admin gets created (safer than a known credential) —
# set this explicitly and restart to bootstrap one.
# ADMIN_PASSWORD=

# --- ML scoring microservice (see ml_service/) ---
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_MS=2000
# Credentials the backend presents to the ML service (see ml_service/utils/auth.py).
# Two DIFFERENT keys, >= 32 chars each, REQUIRED in staging/production:
#   ML_SERVICE_API_KEY - scoring + read-only monitoring
#   ML_ADMIN_API_KEY   - the only key that can reload/roll back/promote models
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# (In development the ML service can run with ML_AUTH_DISABLED=true instead.)
# ML_SERVICE_API_KEY=
# ML_ADMIN_API_KEY=

# --- Logging (config/logger.js, Winston) ---
# error | warn | info | http | debug
# Defaults by NODE_ENV if unset: debug (dev), info (production), error (test).
# LOG_LEVEL=debug

# --- Rate limiting (middleware/rateLimiters.js) ---
# Auth endpoints (register/login) — strict, brute-force protection.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MIN=15
# Transaction submission — protects the ML scoring pipeline from abuse.
RATE_LIMIT_TRANSACTIONS_MAX=60
RATE_LIMIT_TRANSACTIONS_WINDOW_MIN=1

# --- Realtime (see README "Real-Time Capability") ---
# Set to run more than one backend instance (Socket.IO Redis adapter).
# REDIS_URL=redis://localhost:6379
# REALTIME_RETENTION_HOURS=72
# REALTIME_HEARTBEAT_MS=15000
# REALTIME_MAX_SOCKET_BUFFER=500

# --- Model governance (docs/MODEL_GOVERNANCE.md) ---
# Demo only: allow the requester to approve their own model change. Refused in production.
MODEL_CHANGE_ALLOW_SELF_APPROVAL=false
# Roll back automatically (to the version the last workflow promotion replaced) on a critical trigger.
MODEL_AUTO_ROLLBACK=false
MODEL_HEALTH_INTERVAL_MS=60000
MODEL_HEALTH_WINDOW_MINUTES=60
MODEL_HEALTH_MIN_SAMPLES=50
MODEL_HEALTH_MAX_P95_MS=1500
MODEL_HEALTH_MAX_FALLBACK_RATE=0.1
MODEL_HEALTH_MAX_PSI=0.25
MODEL_HEALTH_MIN_PRECISION=0.25
MODEL_HEALTH_MIN_VERDICTS=30
MODEL_OUTCOME_MIN_LABELLED=100
MODEL_OUTCOME_MIN_FRAUD=20

# Decision-audit retention (docs/DECISION_AUDIT.md). Automatic runs are OFF by default.
# DECISION_RETENTION_DAYS=2555
# AUDIT_RETENTION_DAYS=2555
# SNAPSHOT_REDACTION_DAYS=400
# RETENTION_AUTO_RUN=false
# RETENTION_INTERVAL_HOURS=24

# --- Alert case management ---
ALERT_SLA_MINUTES_CRITICAL=60
ALERT_SLA_MINUTES_HIGH=240
ALERT_SLA_MINUTES_MEDIUM=1440
ALERT_SLA_MINUTES_LOW=4320
ALERT_CLAIM_TTL_MINUTES=15
ALERT_ESCALATION_INTERVAL_MS=60000   # 0 disables the escalation sweep
ALERT_MAX_ESCALATION_LEVEL=3
EVIDENCE_MAX_BYTES=2097152
EVIDENCE_MAX_FILES_PER_ALERT=20

# --- Relationship / fraud-ring analysis ---
RELATIONSHIP_WINDOW_DAYS=90
RELATIONSHIP_COMMON_MAX_ACCOUNTS=6     # an IP/device used by more accounts than this is treated as shared infrastructure and ignored as a link
RELATIONSHIP_CACHE_TTL_MS=31000
RELATIONSHIP_BURST_WINDOW_MIN=10
RELATIONSHIP_BURST_MIN_TXNS=6
RELATIONSHIP_SMALL_AMOUNT=5
RELATIONSHIP_SMALL_MIN_COUNT=5
RELATIONSHIP_SMALL_WINDOW_MIN=60
RELATIONSHIP_HARD_OVERRIDE=false       # true = a strong link to analyst-confirmed fraud auto-decides (not recommended)

# --- Rule lifecycle / verification / monitoring ---
RULE_APPROVAL_ALLOW_SELF=false         # true only in dev; blocked in production
RULE_CHANGES_REQUIRE_PROPOSAL=false    # true = direct rule/policy edits return 409 PROPOSAL_REQUIRED
VERIFICATION_SWEEP_INTERVAL_MS=31000   # expires overdue step-up challenges
MONITORING_INTERVAL_MS=3600000         # 0 disables the drift monitor
MONITORING_EMAIL_ALERTS=false
INFERENCE_LOG_RETENTION_DAYS=35
DRIFT_SNAPSHOT_RETENTION_DAYS=365

# --- Geo-velocity, feedback labels, retraining ---
GEO_VELOCITY_MODE=flag                 # off | advisory (record only) | flag (low -> medium, never high, never blocks)
FEEDBACK_ALLOW_SELF_VERIFY=false       # true only in dev; refused in production (labels and retraining runs need a second person)
FEEDBACK_MIN_VERIFIED_PER_CLASS=20
FEEDBACK_MIN_DATASET_ROWS=200


# --- Cognee fraud-intelligence memory (optional) ---
# The backend talks ONLY to the cognee_service microservice (see cognee_service/ and README "Cognee Fraud
# Intelligence Memory"). Leave COGNEE_SERVICE_URL unset to keep the integration completely off.
# None of these values (nor any LLM / embedding key) is ever sent to the browser.
# COGNEE_SERVICE_URL=http://localhost:8002
# Must equal COGNEE_SERVICE_API_KEY on the cognee_service. >= 32 chars; required in staging/production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# COGNEE_SERVICE_API_KEY=
# HMAC secret for customer/device pseudonyms. >= 16 chars, must differ from JWT_SECRET; required in staging/production.
# Changing it re-keys every pseudonym - follow with a full re-sync (and clear the Cognee data).
# COGNEE_PSEUDONYM_SECRET=
COGNEE_SYNC_INTERVAL_MS=310000        # scheduled incremental sync; 0 = manual only
COGNEE_SYNC_BATCH_SIZE=50             # records per request to the service (max 100)
COGNEE_SYNC_MAX_PER_RUN=500           # cap per run; "more pending" is reported and the next run continues
COGNEE_SYNC_LOOKBACK_DAYS=90          # only transactions newer than this are considered
# COGNEE_SYNC_INCLUDE_SYNTHETIC=      # default: true in dev/test (demo data is synthetic), false in production
COGNEE_INCLUDE_ANALYST_NOTES=true     # false = never send alert comments / case notes / outcome notes (they are redacted either way)
COGNEE_REQUEST_TIMEOUT_MS=31000
COGNEE_INGEST_TIMEOUT_MS=180000
COGNEE_MAX_RETRIES=3                  # transient failures only (network, timeout, HTTP 429/5xx); 4xx is never retried
COGNEE_RETRY_BASE_MS=500
RATE_LIMIT_COGNEE_SYNC_MAX=6          # per admin per minute
RATE_LIMIT_COGNEE_QUERY_MAX=30        # per admin per minute (search + assistant)
