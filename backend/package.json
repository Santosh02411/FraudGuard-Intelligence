{
  "name": "fraudguard-backend",
  "version": "1.0.0",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seedDemoData.js",
    "seed:reset": "node scripts/seedDemoData.js --reset",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns tests/perf tests/e2e-fullstack tests/e2e-cognee",
    "test:integration": "jest tests/integration",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js",
    "test:postgres": "bash scripts/test-postgres.sh",
    "test:perf": "jest --runInBand --testMatch '**/tests/perf/*.perf.js' --testTimeout 600000",
    "test:e2e:fullstack": "bash scripts/e2e-fullstack.sh",
    "test:e2e:cognee": "jest --runInBand --testMatch '**/tests/e2e-cognee/*.e2e.js'"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.0",
    "nodemailer": "^9.0.5",
    "otplib": "^12.0.1",
    "pdfkit": "^0.15.2",
    "pg": "^8.11.5",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^4.7.0",
    "socket.io": "^4.7.5",
    "winston": "^3.13.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.7.5",
    "supertest": "^6.3.4"
  },
