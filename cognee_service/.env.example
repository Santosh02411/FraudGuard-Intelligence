# FraudGuard Cognee memory service - copy to .env (or pass as container environment).
# Cognee reads LLM_* / EMBEDDING_* natively; see https://docs.cognee.ai/ for every option.

# ---- Service ----
COGNEE_SERVICE_ENV=development            # development | test | staging | production
# Must equal COGNEE_SERVICE_API_KEY on the FraudGuard backend. >= 32 chars; REQUIRED (boot fails otherwise) in staging/production.
COGNEE_SERVICE_API_KEY=
COGNEE_DATASET=fraudguard-intelligence
COGNEE_DATA_DIR=./.cognee_state           # graph + vector + relational stores and service state live here (back it up / mount a volume)
# COGNEE_AUTH_DISABLED=false              # local-development escape hatch ONLY; refused in staging/production
COGNEE_MAX_BATCH=100
COGNEE_OP_TIMEOUT_S=60
COGNEE_COGNIFY_TIMEOUT_S=900
COGNEE_COGNIFY_DEBOUNCE_S=5
COGNEE_ENABLE_NARRATIVES=true             # false = structured graph + vector search only

# ---- LLM (needed for the narrative layer, graph-completion answers and the assistant's suggestions) ----
# Without an LLM the service still builds the typed graph and answers searches from embedded record summaries;
# /v1/health reports narrative_layer=unavailable_no_llm and the assistant returns evidence only.
LLM_API_KEY=
LLM_PROVIDER=openai                       # openai | anthropic | ollama | ... (any litellm provider)
LLM_MODEL=openai/gpt-4o-mini

# ---- Embeddings ----
# Default with an OpenAI key: OpenAI embeddings. No key: Cognee falls back to a local fastembed model (downloads ~70 MB once).
# EMBEDDING_PROVIDER=fastembed
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_DIMENSIONS=384
# If you change embedding model/dimensions after data exists, clear COGNEE_DATA_DIR and run a force/full sync.

# ---- Cognee defaults applied by this service (override only if you know why) ----
# ENABLE_BACKEND_ACCESS_CONTROL=false     # single-tenant service account behind its own key
